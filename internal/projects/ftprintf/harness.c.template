/* --- %p (ft_printf_p.c) --- */
static int test_p_null(char *exp, char *act, char *expl, char *adv) {
	t_run_res ft, sys;
	void *null_ptr = NULL;
	CAPTURE_CALL(ft, ft_printf("%p", null_ptr));
	CAPTURE_CALL(sys, printf("%p", null_ptr));

	char esc_ft[256];
	char esc_sys[256];
	escape_bytes(esc_ft, sizeof(esc_ft), ft.buf, ft.len);
	escape_bytes(esc_sys, sizeof(esc_sys), sys.buf, sys.len);

	snprintf(exp, 512, "ret: %d, output: \"%s\" (or \"(nil)\" / \"0x0\")", sys.ret, esc_sys);
	snprintf(act, 512, "ret: %d, output: \"%s\"", ft.ret, esc_ft);

	/* 42 Moulinette & libc compatibility: accept (nil) [ret 5] or 0x0 [ret 3] or exact match */
	if (strcmp(ft.buf, "(nil)") == 0 && ft.ret == 5) return 1;
	if (strcmp(ft.buf, "0x0") == 0 && ft.ret == 3) return 1;
	if (ft.ret == sys.ret && ft.len == sys.len && memcmp(ft.buf, sys.buf, (size_t)sys.len) == 0) return 1;

	snprintf(expl, 512, "For NULL pointer %%p, expected '(nil)' (ret 5) or '0x0' (ret 3), got '%s' (ret %d)", esc_ft, ft.ret);
	snprintf(adv, 512, "Ensure NULL pointers are formatted as (nil) or 0x0 with accurate return count.");
	return 0;
}

