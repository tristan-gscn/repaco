	t_run_res ft, sys;
	CAPTURE_CALL(ft, ft_printf("%c%s%d%u%x%X%%", 'A', "BCD", 12, 34U, 0xef, 0xEF));
	CAPTURE_CALL(sys, printf("%c%s%d%u%x%X%%", 'A', "BCD", 12, 34U, 0xef, 0xEF));
	return compare_res(&ft, &sys, exp, act, expl, adv);
}

static int test_mixed_escape_chars(char *exp, char *act, char *expl, char *adv) {
	t_run_res ft, sys;
	CAPTURE_CALL(ft, ft_printf("Escapes:\n\t\"quote\"\r\\slash\\ %d%%\n", 100));
	CAPTURE_CALL(sys, printf("Escapes:\n\t\"quote\"\r\\slash\\ %d%%\n", 100));
	return compare_res(&ft, &sys, exp, act, expl, adv);
}

static int test_mixed_long_format(char *exp, char *act, char *expl, char *adv) {
	t_run_res ft, sys;
	CAPTURE_CALL(ft, ft_printf("Part1: %s, Part2: %d, Part3: %u, Part4: %x, Part5: %X, Part6: %c, Part7: %p, End%%\n",
	                           "very long string with details", 1234567, 7654321U, 0x1234567, 0x7654321, '!', (void *)0x12345678));
	CAPTURE_CALL(sys, printf("Part1: %s, Part2: %d, Part3: %u, Part4: %x, Part5: %X, Part6: %c, Part7: %p, End%%\n",
	                         "very long string with details", 1234567, 7654321U, 0x1234567, 0x7654321, '!', (void *)0x12345678));
	return compare_res(&ft, &sys, exp, act, expl, adv);
}

