} t_test_entry;

typedef struct {
	int ret;
	char buf[8192];
	int len;
} t_run_res;

#define CAPTURE_CALL(res_var, call_expr) do { \
	int p[2]; \
	if (pipe(p) == -1) { (res_var).ret = -1; (res_var).len = 0; (res_var).buf[0] = '\0'; break; } \
	int saved_stdout = dup(STDOUT_FILENO); \
	fflush(stdout); \
	dup2(p[1], STDOUT_FILENO); \
	close(p[1]); \
	(res_var).ret = (call_expr); \
	fflush(stdout); \
	dup2(saved_stdout, STDOUT_FILENO); \
	close(saved_stdout); \
	(res_var).len = read(p[0], (res_var).buf, sizeof((res_var).buf) - 1); \
	close(p[0]); \
	if ((res_var).len < 0) (res_var).len = 0; \
	(res_var).buf[(res_var).len] = '\0'; \
} while (0)

static void escape_bytes(char *dest, size_t dest_sz, const char *src, int len) {
	size_t d = 0;
	for (int i = 0; i < len && d + 6 < dest_sz; i++) {
		unsigned char c = (unsigned char)src[i];
		if (c == '\0') {
			dest[d++] = '\\'; dest[d++] = '0';
		} else if (c == '\n') {
			dest[d++] = '\\'; dest[d++] = 'n';
		} else if (c == '\t') {
			dest[d++] = '\\'; dest[d++] = 't';
		} else if (c == '\r') {
			dest[d++] = '\\'; dest[d++] = 'r';
		} else if (c == '\\') {
			dest[d++] = '\\'; dest[d++] = '\\';
		} else if (c == '\"') {
			dest[d++] = '\\'; dest[d++] = '\"';
		} else if (c < 32 || c >= 127) {
			d += snprintf(dest + d, dest_sz - d, "\\x%02x", c);
		} else {
			dest[d++] = (char)c;
		}
	}
	dest[d] = '\0';
}

static int compare_res(const t_run_res *ft, const t_run_res *sys,
                       char *exp, char *act, char *expl, char *adv) {
	char esc_ft[1024];
	char esc_sys[1024];
	escape_bytes(esc_ft, sizeof(esc_ft), ft->buf, ft->len);
	escape_bytes(esc_sys, sizeof(esc_sys), sys->buf, sys->len);

	snprintf(exp, 512, "ret: %d, output: \"%s\"", sys->ret, esc_sys);
	snprintf(act, 512, "ret: %d, output: \"%s\"", ft->ret, esc_ft);

	if (ft->ret != sys->ret) {
		snprintf(expl, 512, "Return value mismatch: ft_printf returned %d, but printf returned %d.", ft->ret, sys->ret);
		snprintf(adv, 512, "Ensure ft_printf returns the total count of printed characters.");
		return 0;
	}
	if (ft->len != sys->len) {
		snprintf(expl, 512, "Output length mismatch: ft_printf wrote %d bytes, but printf wrote %d bytes.", ft->len, sys->len);
		snprintf(adv, 512, "Check that all characters are written to stdout without truncation.");
		return 0;
	}
	if (memcmp(ft->buf, sys->buf, (size_t)sys->len) != 0) {
		snprintf(expl, 512, "Output content mismatch.");
		snprintf(adv, 512, "Compare the actual output bytes against standard printf.");
		return 0;
	}
	return 1;
}

