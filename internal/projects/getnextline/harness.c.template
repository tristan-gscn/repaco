/* --- Standard Scenarios (get_next_line.c) --- */
static int test_single_line_newline(char *exp, char *act, char *expl, char *adv) {
	const char *content = "Single line with newline.\n";
	int fd = create_test_file(content, strlen(content));
	const char *expected[] = {"Single line with newline.\n", NULL};
	int res = verify_gnl_sequence(fd, expected, 2, exp, act, expl, adv);
	close(fd);
	return res;
}

static int test_single_line_no_newline(char *exp, char *act, char *expl, char *adv) {
	const char *content = "Single line without newline.";
	int fd = create_test_file(content, strlen(content));
	const char *expected[] = {"Single line without newline.", NULL};
	int res = verify_gnl_sequence(fd, expected, 2, exp, act, expl, adv);
	close(fd);
	return res;
}

static int test_multiple_lines(char *exp, char *act, char *expl, char *adv) {
	const char *content = "Line 1: 42 Network\nLine 2: Lausanne\nLine 3: Coding\n";
	int fd = create_test_file(content, strlen(content));
	const char *expected[] = {
		"Line 1: 42 Network\n",
		"Line 2: Lausanne\n",
		"Line 3: Coding\n",
		NULL
	};
	int res = verify_gnl_sequence(fd, expected, 4, exp, act, expl, adv);
	close(fd);
	return res;
}

static int test_no_trailing_newline(char *exp, char *act, char *expl, char *adv) {
	const char *content = "First line with nl\nSecond line without newline";
	int fd = create_test_file(content, strlen(content));
	const char *expected[] = {
		"First line with nl\n",
		"Second line without newline",
		NULL
	};
	int res = verify_gnl_sequence(fd, expected, 3, exp, act, expl, adv);
	close(fd);
	return res;
}

static int test_empty_file(char *exp, char *act, char *expl, char *adv) {
	int fd = create_test_file("", 0);
	const char *expected[] = {NULL};
	int res = verify_gnl_sequence(fd, expected, 1, exp, act, expl, adv);
	close(fd);
	return res;
}

static int test_empty_line_only(char *exp, char *act, char *expl, char *adv) {
	const char *content = "\n";
	int fd = create_test_file(content, 1);
	const char *expected[] = {"\n", NULL};
	int res = verify_gnl_sequence(fd, expected, 2, exp, act, expl, adv);
	close(fd);
	return res;
}

static int test_multiple_empty_lines(char *exp, char *act, char *expl, char *adv) {
	const char *content = "\n\n\n\n";
	int fd = create_test_file(content, 4);
	const char *expected[] = {"\n", "\n", "\n", "\n", NULL};
	int res = verify_gnl_sequence(fd, expected, 5, exp, act, expl, adv);
	close(fd);
	return res;
}

static int test_long_line(char *exp, char *act, char *expl, char *adv) {
	char *buf = malloc(8192);
	if (!buf) return 0;
	memset(buf, 'A', 4000);
	buf[4000] = '\n';
	memset(buf + 4001, 'B', 4000);
	buf[8001] = '\n';
	buf[8002] = '\0';

	int fd = create_test_file(buf, 8002);
	char *line1 = malloc(4002);
	char *line2 = malloc(4002);
	memset(line1, 'A', 4000); line1[4000] = '\n'; line1[4001] = '\0';
	memset(line2, 'B', 4000); line2[4000] = '\n'; line2[4001] = '\0';

	const char *expected[] = {line1, line2, NULL};
	int res = verify_gnl_sequence(fd, expected, 3, exp, act, expl, adv);

	free(line1);
	free(line2);
	free(buf);
	close(fd);
	return res;
}

static int test_short_lines(char *exp, char *act, char *expl, char *adv) {
	const char *content = "a\nb\nc\nd\ne\n";
	int fd = create_test_file(content, 10);
	const char *expected[] = {"a\n", "b\n", "c\n", "d\n", "e\n", NULL};
	int res = verify_gnl_sequence(fd, expected, 6, exp, act, expl, adv);
	close(fd);
	return res;
}

static int test_calls_after_eof(char *exp, char *act, char *expl, char *adv) {
	const char *content = "Only one line\n";
	int fd = create_test_file(content, strlen(content));

	char *l1 = get_next_line(fd);
	if (!l1 || strcmp(l1, "Only one line\n") != 0) {
		snprintf(expl, 512, "Failed to read first line.");
		free(l1); close(fd); return 0;
	}
	free(l1);

	for (int i = 0; i < 5; i++) {
		char *eof_line = get_next_line(fd);
		if (eof_line != NULL) {
			snprintf(exp, 512, "Repeated call %d after EOF: NULL", i + 1);
			snprintf(act, 512, "Repeated call %d after EOF: non-NULL", i + 1);
			snprintf(expl, 512, "get_next_line returned non-NULL after reaching EOF.");
			snprintf(adv, 512, "Always return NULL on any call after EOF.");
			free(eof_line); close(fd); return 0;
		}
	}
	close(fd);
	snprintf(exp, 512, "5 consecutive calls after EOF returned NULL");
	snprintf(act, 512, "All calls returned NULL cleanly");
	return 1;
}

static int test_pipe_read(char *exp, char *act, char *expl, char *adv) {
	int p[2];
	if (pipe(p) == -1) return 0;
	const char *msg = "Pipe line 1\nPipe line 2 without nl";
	ssize_t w = write(p[1], msg, strlen(msg));
	(void)w;
	close(p[1]); // Close write end to trigger EOF on read

	const char *expected[] = {"Pipe line 1\n", "Pipe line 2 without nl", NULL};
	int res = verify_gnl_sequence(p[0], expected, 3, exp, act, expl, adv);
	close(p[0]);
	return res;
}

/* --- Edge Cases (get_next_line_edge_cases.c) --- */
static int test_edge_negative_fd(char *exp, char *act, char *expl, char *adv) {
	char *l1 = get_next_line(-1);
	char *l2 = get_next_line(-42);
	if (l1 != NULL || l2 != NULL) {
		snprintf(exp, 512, "get_next_line(-1) and get_next_line(-42) return NULL");
		snprintf(act, 512, "Returned non-NULL pointer");
		snprintf(expl, 512, "get_next_line did not validate fd < 0.");
		snprintf(adv, 512, "Check if (fd < 0 || BUFFER_SIZE <= 0) return NULL at function start.");
		free(l1); free(l2); return 0;
	}
	snprintf(exp, 512, "NULL");
	snprintf(act, 512, "NULL");
	return 1;
}

static int test_edge_closed_fd(char *exp, char *act, char *expl, char *adv) {
	int fd = create_test_file("Hello\n", 6);
	close(fd); // closed immediately

	char *l = get_next_line(fd);
	if (l != NULL) {
		snprintf(exp, 512, "NULL for closed file descriptor");
		snprintf(act, 512, "Non-NULL returned");
		snprintf(expl, 512, "read() fails on closed fd, get_next_line must return NULL.");
		snprintf(adv, 512, "Handle read() return < 0 by cleaning up and returning NULL.");
		free(l); return 0;
	}
	snprintf(exp, 512, "NULL");
	snprintf(act, 512, "NULL");
	return 1;
}

static int test_edge_large_fd(char *exp, char *act, char *expl, char *adv) {
	char *l = get_next_line(10240);
	if (l != NULL) {
		snprintf(exp, 512, "NULL for out-of-bounds fd");
		snprintf(act, 512, "Non-NULL returned");
		snprintf(expl, 512, "Calling get_next_line on invalid high fd must return NULL.");
		snprintf(adv, 512, "Check if fd is within acceptable range before reading.");
		free(l); return 0;
	}
	snprintf(exp, 512, "NULL");
	snprintf(act, 512, "NULL");
	return 1;
}

/* --- Bonus: Multi-FD reading (get_next_line_bonus.c) --- */
#ifdef HAS_BONUS
static int test_bonus_interleaved(char *exp, char *act, char *expl, char *adv) {
	int fd1 = create_test_file("A1\nA2\nA3\n", 9);
	int fd2 = create_test_file("B1\nB2\n", 6);
	int fd3 = create_test_file("C1\nC2\nC3\nC4\n", 12);

	char *l1 = get_next_line(fd1); // "A1\n"
	char *l2 = get_next_line(fd2); // "B1\n"
	char *l3 = get_next_line(fd3); // "C1\n"
	char *l4 = get_next_line(fd1); // "A2\n"
	char *l5 = get_next_line(fd2); // "B2\n"
	char *l6 = get_next_line(fd2); // NULL (B ends)
	char *l7 = get_next_line(fd3); // "C2\n"
	char *l8 = get_next_line(fd1); // "A3\n"
	char *l9 = get_next_line(fd1); // NULL (A ends)
	char *l10 = get_next_line(fd3); // "C3\n"
	char *l11 = get_next_line(fd3); // "C4\n"
	char *l12 = get_next_line(fd3); // NULL (C ends)

	int ok = 1;
	if (!l1 || strcmp(l1, "A1\n") != 0) ok = 0;
	if (!l2 || strcmp(l2, "B1\n") != 0) ok = 0;
	if (!l3 || strcmp(l3, "C1\n") != 0) ok = 0;
	if (!l4 || strcmp(l4, "A2\n") != 0) ok = 0;
	if (!l5 || strcmp(l5, "B2\n") != 0) ok = 0;
	if (l6 != NULL) ok = 0;
	if (!l7 || strcmp(l7, "C2\n") != 0) ok = 0;
	if (!l8 || strcmp(l8, "A3\n") != 0) ok = 0;
	if (l9 != NULL) ok = 0;
	if (!l10 || strcmp(l10, "C3\n") != 0) ok = 0;
	if (!l11 || strcmp(l11, "C4\n") != 0) ok = 0;
	if (l12 != NULL) ok = 0;

	free(l1); free(l2); free(l3); free(l4); free(l5);
	free(l6); free(l7); free(l8); free(l9); free(l10);
	free(l11); free(l12);
	close(fd1); close(fd2); close(fd3);

	if (!ok) {
		snprintf(exp, 512, "Independent state across 3 file descriptors");
		snprintf(act, 512, "Line content or EOF mismatch across interleaved calls");
		snprintf(expl, 512, "get_next_line failed to maintain separate buffers per file descriptor.");
		snprintf(adv, 512, "Use an array or linked list indexed by fd to store static buffers.");
		return 0;
	}
	snprintf(exp, 512, "Interleaved reads from 3 fds succeeded without losing state");
	snprintf(act, 512, "All lines matched expected values across 3 fds");
	return 1;
}
#endif

