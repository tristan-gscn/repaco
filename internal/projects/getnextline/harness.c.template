/* Helper: create an unlinked temporary file descriptor with given content */
static int create_test_file(const char *content, size_t len) {
	char path[] = "/tmp/repaco_gnl_XXXXXX";
	int fd = mkstemp(path);
	if (fd < 0)
		return -1;
	unlink(path);
	if (len > 0 && content != NULL) {
		ssize_t written = write(fd, content, len);
		(void)written;
		lseek(fd, 0, SEEK_SET);
	}
	return fd;
}

static void escape_str(char *dest, size_t dest_sz, const char *src) {
	if (!src) {
		snprintf(dest, dest_sz, "NULL");
		return ;
	}
	size_t d = 0;
	dest[d++] = '\"';
	for (size_t i = 0; src[i] && d + 6 < dest_sz; i++) {
		unsigned char c = (unsigned char)src[i];
		if (c == '\n') {
			dest[d++] = '\\'; dest[d++] = 'n';
		} else if (c == '\t') {
			dest[d++] = '\\'; dest[d++] = 't';
		} else if (c == '\r') {
			dest[d++] = '\\'; dest[d++] = 'r';
		} else if (c == '\\') {
			dest[d++] = '\\'; dest[d++] = '\\';
		} else if (c == '\"') {
			dest[d++] = '\\'; dest[d++] = '\"';
		} else if (c < 32 || c >= 127) {
			d += snprintf(dest + d, dest_sz - d, "\\x%02x", c);
		} else {
			dest[d++] = (char)c;
		}
	}
	if (d + 2 < dest_sz) {
		dest[d++] = '\"';
	}
	dest[d] = '\0';
}

/* Helper to compare a sequence of expected lines against get_next_line(fd) */
static int verify_gnl_sequence(int fd, const char **expected, size_t exp_count,
                               char *exp_out, char *act_out, char *expl, char *adv) {
	for (size_t i = 0; i < exp_count; i++) {
		char *actual = get_next_line(fd);
		const char *target = expected[i];

		if (target == NULL && actual != NULL) {
			char esc_act[256];
			escape_str(esc_act, sizeof(esc_act), actual);
			snprintf(exp_out, 512, "Call %zu: NULL (EOF)", i + 1);
			snprintf(act_out, 512, "Call %zu: %s", i + 1, esc_act);
			snprintf(expl, 512, "get_next_line returned a string when NULL was expected at EOF.");
			snprintf(adv, 512, "Ensure get_next_line returns NULL when EOF is reached.");
			free(actual);
			return 0;
		}

		if (target != NULL && actual == NULL) {
			char esc_exp[256];
			escape_str(esc_exp, sizeof(esc_exp), target);
			snprintf(exp_out, 512, "Call %zu: %s", i + 1, esc_exp);
			snprintf(act_out, 512, "Call %zu: NULL", i + 1);
			snprintf(expl, 512, "get_next_line returned NULL prematurely before reading the full line.");
			snprintf(adv, 512, "Check loop termination and buffer stitching logic.");
			return 0;
		}

		if (target != NULL && actual != NULL) {
			if (strcmp(actual, target) != 0) {
				char esc_exp[256];
				char esc_act[256];
				escape_str(esc_exp, sizeof(esc_exp), target);
				escape_str(esc_act, sizeof(esc_act), actual);
				snprintf(exp_out, 512, "Call %zu: %s", i + 1, esc_exp);
				snprintf(act_out, 512, "Call %zu: %s", i + 1, esc_act);
				snprintf(expl, 512, "Line content mismatch on call %zu.", i + 1);
				snprintf(adv, 512, "Ensure the newline '\\n' is preserved in the line unless at EOF.");
				free(actual);
				return 0;
			}
			free(actual);
		}
	}

	/* Also verify subsequent call after EOF returns NULL */
	char *after = get_next_line(fd);
	if (after != NULL) {
		char esc_act[256];
		escape_str(esc_act, sizeof(esc_act), after);
		snprintf(exp_out, 512, "Call after EOF: NULL");
		snprintf(act_out, 512, "Call after EOF: %s", esc_act);
		snprintf(expl, 512, "get_next_line failed to return NULL on subsequent calls after EOF.");
		snprintf(adv, 512, "Ensure static buffer is properly reset to NULL after EOF.");
		free(after);
		return 0;
	}

	snprintf(exp_out, 512, "%zu lines matched expected output", exp_count);
	snprintf(act_out, 512, "%zu lines read successfully", exp_count);
	return 1;
}

