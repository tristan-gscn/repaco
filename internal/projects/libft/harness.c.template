static const size_t g_num_tests = sizeof(g_tests) / sizeof(g_tests[0]);

int main(int argc, char **argv) {
	if (argc < 2) {
		fprintf(stderr, "Usage: %s <list|run <id>>\n", argv[0]);
		return 1;
	}

	if (strcmp(argv[1], "list") == 0) {
		for (size_t i = 0; i < g_num_tests; i++) {
			printf("%s\t%s\t%s\t%s\t%s\n",
				g_tests[i].id,
				g_tests[i].module,
				g_tests[i].name,
				g_tests[i].category,
				g_tests[i].desc);
		}
		return 0;
	}

	if (strcmp(argv[1], "run") == 0 && argc >= 3) {
		const char *target_id = argv[2];
		for (size_t i = 0; i < g_num_tests; i++) {
			if (strcmp(g_tests[i].id, target_id) == 0) {
				char exp[512] = {0};
				char act[512] = {0};
				char expl[512] = {0};
				char adv[512] = {0};

				int pass = g_tests[i].fn(exp, act, expl, adv);
				if (pass) {
					printf("STATUS: PASS\n");
					if (!exp[0] && g_tests[i].expected) {
						snprintf(exp, sizeof(exp), "%s", g_tests[i].expected);
					}
					if (!act[0]) {
						snprintf(act, sizeof(act), "%s", exp[0] ? exp : "Success: matches expected behavior");
					}
				} else {
					printf("STATUS: FAIL\n");
					if (!exp[0] && g_tests[i].expected) {
						snprintf(exp, sizeof(exp), "%s", g_tests[i].expected);
					}
				}
				if (g_tests[i].input && g_tests[i].input[0]) {
					printf("INPUT: %s\n", g_tests[i].input);
				}
				if (exp[0]) printf("EXPECTED: %s\n", exp);
				if (act[0]) printf("ACTUAL: %s\n", act);
				if (g_tests[i].code && g_tests[i].code[0]) {
					printf("CODE_START\n%s\nCODE_END\n", g_tests[i].code);
				}
				if (!pass) {
					if (expl[0]) printf("EXPLANATION: %s\n", expl);
					if (adv[0]) printf("ADVICE: %s\n", adv);
				}
				return pass ? 0 : 1;
			}
		}
		fprintf(stderr, "Unknown test id: %s\n", target_id);
		return 2;
	}

	return 1;
}
