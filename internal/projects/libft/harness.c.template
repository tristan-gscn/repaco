static int test_putnbr_fd(char *exp, char *act, char *expl, char *adv) {
	int cases[] = {0, 42, -42, INT_MAX, INT_MIN};
	const char *expected[] = {"0", "42", "-42", "2147483647", "-2147483648"};
	for (size_t i = 0; i < sizeof(cases)/sizeof(cases[0]); i++) {
		int p[2];
		if (pipe(p) < 0) continue;
		ft_putnbr_fd(cases[i], p[1]);
		close(p[1]);
		char buf[32] = {0};
