/* --- isalpha --- */
static int test_isalpha_alpha(char *exp, char *act, char *expl, char *adv) {
	for (int c = 'a'; c <= 'z'; c++) {
		if (ft_isalpha(c) == 0) {
			snprintf(exp, 128, "Non-zero for '%c'", c);
			snprintf(act, 128, "0");
			snprintf(expl, 256, "ft_isalpha returned 0 for lowercase '%c'", c);
			snprintf(adv, 256, "Ensure lowercase characters 'a'-'z' return non-zero.");
			return 0;
		}
	}
	for (int c = 'A'; c <= 'Z'; c++) {
		if (ft_isalpha(c) == 0) {
			snprintf(exp, 128, "Non-zero for '%c'", c);
			snprintf(act, 128, "0");
			snprintf(expl, 256, "ft_isalpha returned 0 for uppercase '%c'", c);
			snprintf(adv, 256, "Ensure uppercase characters 'A'-'Z' return non-zero.");
			return 0;
		}
	}
	return 1;
}

static int test_isalpha_nonalpha(char *exp, char *act, char *expl, char *adv) {
	int non_alphas[] = {'0', '9', '@', '[', '`', '{', ' ', '\t', '\0', 127, 200};
	for (size_t i = 0; i < sizeof(non_alphas)/sizeof(non_alphas[0]); i++) {
		int c = non_alphas[i];
		if (ft_isalpha(c) != 0) {
			snprintf(exp, 128, "0 for ascii %d", c);
			snprintf(act, 128, "%d", ft_isalpha(c));
			snprintf(expl, 256, "ft_isalpha returned non-zero for non-alpha char (ascii %d)", c);
			snprintf(adv, 256, "Only letters [a-zA-Z] must return non-zero.");
			return 0;
		}
	}
	return 1;
}

