/* Helper functions for strmapi / striteri */
static char map_rot1(unsigned int i, char c) {
	(void)i;
	return (char)(c + 1);
}
static char map_index(unsigned int i, char c) {
	return (char)(c + i);
}
static void iter_rot1(unsigned int i, char *c) {
	(void)i;
	*c = (char)(*c + 1);
}

/* Helper del function for lists */
static int g_del_count = 0;
static void del_counter(void *content) {
	(void)content;
	g_del_count++;
}
static void *map_dup(void *content) {
	return strdup((char *)content);
}

