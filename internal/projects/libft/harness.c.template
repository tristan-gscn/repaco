			snprintf(exp, 128, "'%s'", expected[i]);
			snprintf(act, 128, "'%s'", buf);
			snprintf(expl, 256, "ft_putnbr_fd failed for %d", cases[i]);
			snprintf(adv, 256, "Carefully handle INT_MIN (-2147483648): -n overflows in 32-bit int!");
			return 0;
		}
	}
	return 1;
}

