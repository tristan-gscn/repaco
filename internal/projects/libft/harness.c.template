/* --- putchar_fd, putstr_fd, putendl_fd, putnbr_fd --- */
static int test_put_fd(char *exp, char *act, char *expl, char *adv) {
	int p[2];
	if (pipe(p) < 0) return 1;

	ft_putchar_fd('X', p[1]);
	ft_putstr_fd("42", p[1]);
	ft_putendl_fd("End", p[1]);
	ft_putnbr_fd(-2147483648, p[1]);
	close(p[1]);

	char buf[64] = {0};
	ssize_t bytes = read(p[0], buf, sizeof(buf) - 1);
	close(p[0]);

	const char *expected = "X42End\n-2147483648";
	if (bytes < 0 || strcmp(buf, expected) != 0) {
		snprintf(exp, 128, "'%s'", expected);
		snprintf(act, 128, "'%s'", buf);
		snprintf(expl, 256, "ft_put*_fd outputs do not match expected pipe data");
		snprintf(adv, 256, "Use write(fd, ...) for all put*_fd functions.");
		return 0;
	}
	return 1;
}

/* --- Bonus: t_list tests --- */
static int test_bonus_lists(char *exp, char *act, char *expl, char *adv) {
	/* lstnew */
	t_list *elem1 = ft_lstnew(strdup("first"));
	if (!elem1 || strcmp((char*)elem1->content, "first") != 0 || elem1->next != NULL) {
		snprintf(exp, 128, "Node with content 'first', next == NULL");
		snprintf(act, 128, "Invalid node");
		snprintf(expl, 256, "ft_lstnew failed initialization");
		snprintf(adv, 256, "Set node->content = content and node->next = NULL.");
		return 0;
	}

	/* lstadd_front */
	t_list *head = elem1;
	t_list *elem0 = ft_lstnew(strdup("zero"));
	ft_lstadd_front(&head, elem0);
	if (head != elem0 || head->next != elem1) {
		snprintf(exp, 128, "elem0 at head, followed by elem1");
		snprintf(act, 128, "Incorrect head linkage");
		snprintf(expl, 256, "ft_lstadd_front failed");
		snprintf(adv, 256, "new->next = *lst; *lst = new;");
		return 0;
	}

	/* lstsize */
	if (ft_lstsize(head) != 2 || ft_lstsize(NULL) != 0) {
		snprintf(exp, 128, "Size 2 and 0 for NULL");
		snprintf(act, 128, "Size %d", ft_lstsize(head));
		snprintf(expl, 256, "ft_lstsize returned incorrect count");
		snprintf(adv, 256, "Iterate and count nodes.");
		return 0;
	}

	/* lstlast */
	if (ft_lstlast(head) != elem1 || ft_lstlast(NULL) != NULL) {
		snprintf(exp, 128, "elem1 as last node");
		snprintf(act, 128, "Mismatch");
		snprintf(expl, 256, "ft_lstlast failed");
		snprintf(adv, 256, "Iterate while lst->next != NULL.");
		return 0;
	}

	/* lstadd_back */
	t_list *elem2 = ft_lstnew(strdup("second"));
	ft_lstadd_back(&head, elem2);
	if (ft_lstlast(head) != elem2 || ft_lstsize(head) != 3) {
		snprintf(exp, 128, "elem2 at tail of list, size 3");
		snprintf(act, 128, "Mismatch");
		snprintf(expl, 256, "ft_lstadd_back failed to append node");
		snprintf(adv, 256, "Find last node and link last->next = new.");
		return 0;
	}

	/* lstmap */
	t_list *mapped = ft_lstmap(head, map_dup, free);
	if (!mapped || ft_lstsize(mapped) != 3) {
		snprintf(exp, 128, "New list of size 3");
		snprintf(act, 128, "NULL or wrong size");
		snprintf(expl, 256, "ft_lstmap failed to clone and map list");
		snprintf(adv, 256, "Iterate, apply f(), create new nodes, handle failure with ft_lstclear.");
		return 0;
	}
	ft_lstclear(&mapped, free);

	/* lstclear & del */
	g_del_count = 0;
	ft_lstclear(&head, del_counter);
	if (head != NULL || g_del_count != 3) {
		snprintf(exp, 128, "head == NULL, 3 deletions");
		snprintf(act, 128, "head = %p, del_count = %d", (void*)head, g_del_count);
		snprintf(expl, 256, "ft_lstclear did not delete all elements or did not set *lst = NULL");
		snprintf(adv, 256, "Call del() on each content, free node, and set *lst = NULL.");
		return 0;
	}
	return 1;
}

